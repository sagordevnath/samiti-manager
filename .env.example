# ── Root ──────────────────────────────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit real secrets.

# ── Supabase ──────────────────────────────────────────────────────────────
# Project Settings → API keys in the Supabase dashboard.
# ⚠️ Until these hold REAL values, the API runs in demo mode (in-memory data).
#    Fill them in + run supabase/demo-seed-full.sql to switch to live database mode.
# ⚠️ SUPABASE_SERVICE_ROLE_KEY must be the SERVICE_ROLE secret — NOT the anon
#    key! Both legacy keys are long eyJ… JWTs that look alike: decode the
#    middle segment and check it says "role":"service_role" (the anon key says
#    "role":"anon"). With the anon key in this slot the API boots and login
#    works, but every database read returns 0 rows (RLS blocks anon) — the
#    #1 cause of "live pages show no data". New-format sb_secret_… keys also
#    work. The API prints a loud warning at boot when it detects the mix-up.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-KEEP-SECRET
SUPABASE_JWT_SECRET=your-jwt-secret-from-project-settings
# ── API (apps/api/.env) ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated origins allowed by CORS, e.g. http://localhost:5173,http://localhost:4173
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# Master key for member NID/birth-registration field encryption (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MEMBER_ENC_KEY=replace-with-random-32-byte-base64-key

# ── Web (apps/web/.env — Vite only exposes vars prefixed with VITE_) ────────
VITE_API_URL=http://localhost:4000/api/v1
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Database demo seed ───────────────────────────────────────────────────────
# supabase/demo-seed-full.sql: paste into Supabase SQL Editor (after migrations)
# to load the FULL demo dataset AND the login user admin@samity.test /
# Samity@2026 (super_admin). Idempotent; safe to re-run. See docs/demo-data.md.
