# ── Samity Manager — environment template ────────────────────────────────────
# Copy to .env (never commit it) and fill in. Both the API and the web build
# read from here in development; in production each host gets its own values.
#
#   Development:  npm run dev:local          (reads this file)
#   Production:   set these as environment variables on the API host
#
# ── Data mode ────────────────────────────────────────────────────────────────
# The API serves one of two stores. This is the switch.
#   auto  (default) — sample data until real Supabase credentials exist below,
#                     real data afterwards. Best for dev and staging.
#   force           — always the in-memory sample store. Use for a public sales
#                     demo: full dataset, no database, no secrets needed.
#   off             — live only. The API refuses to boot while the Supabase
#                     values are still placeholders, so a production deploy can
#                     never silently serve fake data.
DEMO_MODE=auto

# ── Supabase ─────────────────────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API keys.
# ⚠️ SUPABASE_SERVICE_ROLE_KEY must be the SERVICE_ROLE secret — NOT the anon
#    key! Both legacy keys are long eyJ… JWTs that look alike: decode the
#    middle segment and check it says "role":"service_role" (the anon key says
#    "role":"anon"). With the anon key in this slot the API boots and login
#    works, but every database read returns 0 rows (RLS blocks anon) — the
#    #1 cause of "live pages show no data". New-format sb_secret_… keys also
#    work. The API prints a loud warning at boot when it detects the mix-up.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-KEEP-SECRET
# Project Settings → API → JWT Settings. Used to verify legacy HS256 tokens;
# asymmetric (ES256) tokens are verified against the project's JWKS instead.
SUPABASE_JWT_SECRET=your-jwt-secret-from-project-settings
# Connection string (Project Settings → Database → Connection string → URI).
# Needed only by `npm run db:migrate` / `db:seed`, never by the API at runtime.
SUPABASE_DB=postgresql://postgres:PASSWORD@db.YOUR-PROJECT-ref.supabase.co:5432/postgres

# ── API (apps/api) ───────────────────────────────────────────────────────────
# development | test | production. Production enforces the explicit
# CORS_ORIGINS allow-list only (no loopback shortcut).
NODE_ENV=development
PORT=4000
# Comma-separated browser origins allowed to call the API.
# ⚠️ In production this MUST list the deployed web origin, e.g.
#    CORS_ORIGINS=https://your-site.netlify.app
#    A missing entry shows up in the browser as a CORS error and in the app as
#    "cannot reach the API".
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
LOG_LEVEL=info
# Master key for member NID/birth-registration field encryption (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠️ Changing this key after real member data exists makes those fields unreadable.
MEMBER_ENC_KEY=replace-with-random-32-byte-base64-key
# Interest posting cadence for the scheduled savings job.
SAVINGS_INTEREST_FREQUENCY=monthly

# ── Web (apps/web) ───────────────────────────────────────────────────────────
# Read at BUILD time by Vite. The web app talks to the API only — it never
# connects to Supabase directly, so no Supabase keys belong here.
#
#   Local dev:  leave unset; the Vite dev server proxies /api/v1 → :4000.
#   Production: set VITE_API_URL on the static host (Netlify → Site
#               configuration → Environment variables) and rebuild:
#                 VITE_API_URL=https://YOUR-API-HOST/api/v1
#               Forgetting this is the #1 cause of a deployed site showing no
#               data. To repoint a deployed site WITHOUT rebuilding, edit
#               /config.js in the published deploy instead — see docs/deploy.md.
#                 window.__SAMITY_CONFIG__ = { apiUrl: 'https://YOUR-API-HOST/api/v1' };
#               A production build on a static host FAILS without this value, or
#               without SAMITY_ALLOW_UNCONFIGURED_API=1 for deployments whose
#               address comes from /config.js or a same-origin reverse proxy.
VITE_API_URL=http://localhost:4000/api/v1

# ── Demo dataset (optional) ──────────────────────────────────────────────────
# supabase/demo-seed-full.sql — paste into the Supabase SQL Editor (after
# migrations) to load the full demo dataset AND the login user
# admin@samity.test / Samity@2026 (super_admin). Idempotent; safe to re-run.
# See docs/demo-data.md. Never run this against a production database.
