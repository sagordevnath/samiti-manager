# ── API (apps/api/.env) ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated origins allowed by CORS, e.g. http://localhost:5173,http://localhost:4173
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# Master key for member NID/birth-registration field encryption (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MEMBER_ENC_KEY=replace-with-random-32-byte-base64-key

# ── Web (apps/web/.env — Vite only exposes vars prefixed with VITE_) ────────
VITE_API_URL=http://localhost:4000/api/v1
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

